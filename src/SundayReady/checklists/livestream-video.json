{
  // SAMPLE. Delete this and write what your booth actually does - see "Making it yours"
  // in the README. The paths, camera names and software here are illustrative, not a
  // description of anyone's room.
  "station": "Livestream Video",
  "name": "Video",
  "items": [
    {
      "label": "Camera power on and lens caps off",
      "type": "manual",
      "section": "Cameras & capture"
    },
    {
      "label": "Launch vMix with the Sunday preset",
      "type": "action",
      "section": "Cameras & capture",
      "action": {
        "run": "C:\\Program Files (x86)\\vMix\\vMix64.exe",
        "args": "\"C:\\vMix\\Presets\\Sunday.vmix\""
      },
      "verify": {
        "kind": "httpContains",
        "url": "http://127.0.0.1:8088/api",
        "contains": "<vmix>"
      }
    },
    {
      "label": "Cam 3 present in vMix inputs",
      "type": "verified",
      "section": "Cameras & capture",
      "verify": {
        "kind": "httpContains",
        "url": "http://127.0.0.1:8088/api",
        "contains": "Cam 3",
        "maxAttempts": 3
      },
      "checkSteps": [
        "Is Cam 3's PoE injector lit? Say where yours is - that detail is the point of these steps.",
        "In vMix, does Add Input \u2192 NDI list the camera? If it does, add it and rename to Cam 3.",
        "Still nothing \u2014 reload the Sunday preset. It carries every input.",
        "Out of time? Override below and note which camera is missing."
      ],
      "remediationLabel": "Reload preset",
      "remediation": { "run": "C:\\vMix\\Presets\\Sunday.vmix" }
    },
    {
      "label": "SD cards formatted and seated in every camera",
      "type": "manual",
      "section": "Cameras & capture"
    },
    {
      "label": "Internet reachable",
      "type": "verified",
      "section": "Stream path",
      "verify": { "kind": "internetReachable" }
    },
    {
      "label": "Open the YouTube & Facebook stream dashboards",
      "type": "action",
      "section": "Stream path",
      "action": {
        "run": "https://studio.youtube.com/channel/live",
        "label": "Launch both",
        "also": [
          { "run": "https://www.facebook.com/live/producer" }
        ]
      }
    },
    {
      "label": "Record armed \u2014 multitrack and per-camera ISO",
      "type": "manual",
      "section": "Stream path"
    }
  ]
}
