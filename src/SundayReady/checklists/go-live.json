{
  // Sample content. The last four things before the stream key goes hot.
  "station": "Livestream Video",
  "name": "Go Live",
  "items": [
    {
      "label": "Set up the stream in Subsplash",
      "type": "manual",
      "section": "Final",
      // "instructions" are read-only: the HOW? chip on the row opens them. For the job
      // someone does four times a year and cannot be expected to remember.
      "instructions": [
        "Open the Subsplash dashboard and sign in.",
        "Media → Live → New broadcast.",
        "Name it for this Sunday, e.g. \"Sunday 16 August — 10:30\".",
        "Copy the RTMP server and stream key from the Encoder panel."
      ],
      // "subSteps" are ticked off individually. Finishing them all ticks this item, and the
      // item can still be ticked directly by someone who knows the routine.
      "subSteps": [
        "Broadcast created in Subsplash",
        "Stream key pasted into vMix",
        "Title and thumbnail set",
        "Test frame visible in the Subsplash preview"
      ]
    },
    {
      "label": "Countdown loop running on the stream output",
      "type": "manual",
      "section": "Final"
    },
    {
      "label": "Stream titles match this week's service",
      "type": "manual",
      "section": "Final"
    },
    {
      "label": "vMix still responding",
      "type": "verified",
      "section": "Final",
      "verify": {
        "kind": "httpContains",
        "url": "http://127.0.0.1:8088/api",
        "contains": "<vmix>",
        "maxAttempts": 3
      },
      "checkSteps": [
        "Is vMix still on screen, or did it close? Relaunch it from the Video tab.",
        "If vMix is up but this stays red, its web controller is off: Settings → Web Controller → Enabled.",
        "Confirm nothing else grabbed port 8088."
      ]
    },
    {
      "label": "Both platforms show a healthy incoming stream",
      "type": "manual",
      "section": "Final"
    }
  ]
}
