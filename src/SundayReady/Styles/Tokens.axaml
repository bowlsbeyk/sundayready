<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Design tokens from the handoff. Status hues were authored in oklch at a matched
        lightness/chroma; Avalonia cannot parse oklch, and the handoff says to fall back to
        the supplied hex in that case, so these are the hex values verbatim.

        The three derived accents with no hex given (failure body text, the failed AUTO tag,
        and the action hover) are colour-matched into the same family.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgBrush" Color="#0b0d10" />
    <SolidColorBrush x:Key="PanelBrush" Color="#161a20" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#1c212a" />
    <SolidColorBrush x:Key="RailBgBrush" Color="#12161b" />

    <!-- Hairlines. Depth comes from surface lightness only — no shadows anywhere. -->
    <SolidColorBrush x:Key="HairlineBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="HairlineDashedBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="RowBorderBrush" Color="#1FFFFFFF" />

    <!-- White overlays, by the alpha the design calls for -->
    <SolidColorBrush x:Key="Overlay02Brush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Overlay03Brush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Overlay04Brush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Overlay05Brush" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="Overlay06Brush" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="Overlay08Brush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Overlay09Brush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="Overlay10Brush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Overlay13Brush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="Overlay14Brush" Color="#42FFFFFF" />
    <SolidColorBrush x:Key="Overlay20Brush" Color="#54FFFFFF" />
    <SolidColorBrush x:Key="Overlay22Brush" Color="#5CFFFFFF" />

    <!-- Dim behind the guided tour's spotlight. Dark rather than a lightening overlay, because
         it has to read as "not this bit" over panels that are already near-black. -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#B4000000" />

    <!-- System map surfaces (design handoff: node hierarchy is surface, not size). -->
    <SolidColorBrush x:Key="MapBgBrush" Color="#0d1116" />
    <SolidColorBrush x:Key="NodeHubBrush" Color="#252c37" />
    <SolidColorBrush x:Key="BorderNodeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="BorderHubBrush" Color="#5CFFFFFF" />

    <!-- Text ramp -->
    <SolidColorBrush x:Key="TextBrush" Color="#e9ebee" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#d6dbe2" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#c2c8d0" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#9ba3ad" />
    <SolidColorBrush x:Key="TextFainterBrush" Color="#8a929c" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#79818b" />
    <SolidColorBrush x:Key="TextLockedBrush" Color="#69707a" />

    <!-- Status. Grey means no human has looked at this yet. -->
    <SolidColorBrush x:Key="OkBrush" Color="#4ade9a" />
    <SolidColorBrush x:Key="WaitBrush" Color="#f5bf45" />
    <SolidColorBrush x:Key="FailBrush" Color="#ff6b52" />
    <SolidColorBrush x:Key="ActionBrush" Color="#5aa9ff" />
    <SolidColorBrush x:Key="ActionHoverBrush" Color="#84c0ff" />
    <SolidColorBrush x:Key="FailTextBrush" Color="#ffb3a4" />
    <SolidColorBrush x:Key="FailTagBrush" Color="#ff8a75" />

    <!-- Status tints: fills at .06–.12, borders at .35–.45 -->
    <SolidColorBrush x:Key="FailFillBrush" Color="#26ff6b52" />
    <SolidColorBrush x:Key="FailPillFillBrush" Color="#33ff6b52" />
    <SolidColorBrush x:Key="FailBorderBrush" Color="#99ff6b52" />
    <SolidColorBrush x:Key="FailPillBorderBrush" Color="#8Cff6b52" />
    <SolidColorBrush x:Key="WaitBorderBrush" Color="#80f5bf45" />
    <SolidColorBrush x:Key="WaitFillBrush" Color="#0Fd6a53c" />
    <SolidColorBrush x:Key="OkFillBrush" Color="#1A4ec27f" />

    <!--
        Techdesk tints. The station cards and the wall board fill a whole header or tile with a
        status colour rather than just outlining a row, so they need the same hues one step up
        in alpha, plus the lighter status text the handoff specifies on those fills.
    -->
    <SolidColorBrush x:Key="OkTintBorderBrush" Color="#4D4ec27f" />
    <SolidColorBrush x:Key="OkTintBorderStrongBrush" Color="#594ec27f" />
    <SolidColorBrush x:Key="OkTextBrush" Color="#7ecf9f" />
    <SolidColorBrush x:Key="FailTintBrush" Color="#1Ad75a44" />
    <SolidColorBrush x:Key="FailTintBorderBrush" Color="#59d75a44" />
    <SolidColorBrush x:Key="FailStrongBrush" Color="#e5765c" />
    <SolidColorBrush x:Key="FailBodyBrush" Color="#f2b5aa" />
    <SolidColorBrush x:Key="FailDimBrush" Color="#dd8b78" />
    <SolidColorBrush x:Key="WaitTintBrush" Color="#1Ad6a53c" />
    <SolidColorBrush x:Key="WaitPillFillBrush" Color="#1Fd6a53c" />
    <SolidColorBrush x:Key="WaitPillBorderBrush" Color="#61d6a53c" />
    <SolidColorBrush x:Key="WaitTextBrush" Color="#e8bf62" />

    <!-- Text on a filled status button is never white. -->
    <SolidColorBrush x:Key="OnStatusBrush" Color="#0b0d10" />
    <SolidColorBrush x:Key="OnOkBrush" Color="#07140c" />
    <SolidColorBrush x:Key="OnActionBrush" Color="#08131f" />

    <!--
        Typography. The handoff specifies Archivo + JetBrains Mono but explicitly allows
        substitution: "the Archivo/mono split is the load-bearing idea, not Archivo
        specifically". Inter already ships with the app via Avalonia.Fonts.Inter and is the
        inherited default, so UI text sets no family. Machine data uses the mono stack —
        Cascadia Mono ships with Windows 11, Consolas with everything older.
    -->
    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New</FontFamily>
</ResourceDictionary>
