<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Type ramp and controls from the handoff. Motion is deliberately almost absent, and
        there is no hover styling beyond tabs and quick-launch tiles.
    -->

    <!-- ==== Text ==== -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>

    <!-- Mono uppercase micro-label: the smallest type in the app. -->
    <Style Selector="TextBlock.microLabel">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.32" />
        <Setter Property="Foreground" Value="{StaticResource TextFainterBrush}" />
    </Style>

    <Style Selector="TextBlock.wordmark">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-0.22" />
    </Style>

    <Style Selector="TextBlock.screenTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.itemLabel">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="24.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.subLine">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16.8" />
        <Setter Property="Foreground" Value="{StaticResource TextFainterBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- The failure sub-line carries the reason, so it gets the readable red, not the fill red. -->
    <Style Selector="TextBlock.subLine.failure">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19.5" />
        <Setter Property="Foreground" Value="{StaticResource FailTextBrush}" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>

    <Style Selector="TextBlock.subLine.polling">
        <Setter Property="Foreground" Value="{StaticResource WaitBrush}" />
    </Style>

    <Style Selector="TextBlock.typeTag">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LetterSpacing" Value="1.1" />
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
    </Style>

    <Style Selector="TextBlock.typeTag.waiting">
        <Setter Property="Foreground" Value="{StaticResource WaitBrush}" />
    </Style>

    <Style Selector="TextBlock.typeTag.failing">
        <Setter Property="Foreground" Value="{StaticResource FailTagBrush}" />
    </Style>

    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.32" />
        <Setter Property="Foreground" Value="{StaticResource TextFainterBrush}" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style Selector="TextBlock.railBody">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="22.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ==== Buttons ==== -->

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource ActionBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnActionBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ActionHoverBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource OnActionBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ActionBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource OnActionBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{StaticResource FailBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnStatusBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource FailBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource OnStatusBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{StaticResource Overlay05Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Overlay08Brush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    </Style>

    <!-- Quiet mono chip, e.g. RELAUNCH on an already-verified action item. -->
    <Style Selector="Button.chip">
        <Setter Property="Background" Value="{StaticResource Overlay04Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Overlay08Brush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Overlay05Brush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Overlay08Brush}" />
    </Style>

    <!-- Quick-launch tile. Hover brightens the border only. -->
    <Style Selector="Button.tile">
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Overlay08Brush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,13" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Overlay20Brush}" />
    </Style>

    <!-- Tab. Active tab reads as a raised surface joined to the list below it. -->
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6,6,0,0" />
        <Setter Property="Padding" Value="20,11" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Overlay03Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tab.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    </Style>
    <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    </Style>

    <!-- The gate. Inert until every item on every tab is accounted for. -->
    <Style Selector="Button.gate">
        <Setter Property="Background" Value="{StaticResource Overlay03Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextLockedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.gate:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Overlay03Brush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextLockedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.gate.open">
        <Setter Property="Background" Value="{StaticResource OkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnOkBrush}" />
    </Style>
    <Style Selector="Button.gate.open:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource OkBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource OnOkBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Sub-step row: a whole-row hit target, drawn flat rather than as a button. -->
    <Style Selector="Button.subStep">
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RowBorderBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.subStep:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Overlay06Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    </Style>

    <!-- ==== Checklist rows ==== -->

    <Style Selector="Border.row">
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <!-- Padding lives on the inner grid so the launchable accent stripe can sit flush
             against the row edge, the way an inset box-shadow does. -->
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.row.polling">
        <Setter Property="BorderBrush" Value="{StaticResource WaitBorderBrush}" />
    </Style>

    <Style Selector="Border.row.failed">
        <Setter Property="Background" Value="{StaticResource FailFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FailBorderBrush}" />
    </Style>

    <!--
        Slot and tag centre on an ordinary row and align to the top on a failed one, which
        grows to hold its explanation. These must be set here rather than inline on the
        elements: a local value outranks a style setter, so an inline VerticalAlignment
        would make the .failed selector below do nothing.
    -->
    <Style Selector="Border.row Panel.statusSlot">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.row StackPanel.rightSlot">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.row.failed Panel.statusSlot">
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.row.failed StackPanel.rightSlot">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- ==== Techdesk ==== -->

    <!--
        Station state is carried by a class on the container, and every colour inside it hangs
        off that class. Set here rather than inline on the children: a local value outranks a
        style setter, so an inline Foreground would leave the state selectors doing nothing.
        No class at all is the silent station — grey, because no human has looked at it.
    -->

    <Style Selector="Border.stationCard">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.stationCard.failing">
        <Setter Property="BorderBrush" Value="{StaticResource FailPillBorderBrush}" />
    </Style>

    <Style Selector="Border.stationHeader">
        <Setter Property="Background" Value="{StaticResource Overlay03Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Overlay08Brush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style Selector="Border.stationHeader.ok">
        <Setter Property="Background" Value="{StaticResource OkFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OkTintBorderBrush}" />
    </Style>
    <Style Selector="Border.stationHeader.failing">
        <Setter Property="Background" Value="{StaticResource FailTintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FailTintBorderBrush}" />
    </Style>

    <Style Selector="Border.stationHeader Ellipse.statusDot">
        <Setter Property="Fill" Value="{StaticResource TextLockedBrush}" />
    </Style>
    <Style Selector="Border.stationHeader.ok Ellipse.statusDot">
        <Setter Property="Fill" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="Border.stationHeader.failing Ellipse.statusDot">
        <Setter Property="Fill" Value="{StaticResource FailBrush}" />
    </Style>
    <Style Selector="Border.stationHeader.partial Ellipse.statusDot">
        <Setter Property="Fill" Value="{StaticResource WaitBrush}" />
    </Style>

    <Style Selector="Border.stationHeader TextBlock.stationFigure">
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    </Style>
    <Style Selector="Border.stationHeader.ok TextBlock.stationFigure">
        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="Border.stationHeader.failing TextBlock.stationFigure">
        <Setter Property="Foreground" Value="{StaticResource FailTextBrush}" />
    </Style>
    <Style Selector="Border.stationHeader.partial TextBlock.stationFigure">
        <Setter Property="Foreground" Value="{StaticResource WaitTextBrush}" />
    </Style>

    <!-- 1d's station tile: the same states, one size up and without the card body. -->
    <Style Selector="Border.boardTile">
        <Setter Property="Background" Value="{StaticResource Overlay03Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Overlay09Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="Border.boardTile.ok">
        <Setter Property="Background" Value="{StaticResource OkFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OkTintBorderStrongBrush}" />
    </Style>
    <Style Selector="Border.boardTile.failing">
        <Setter Property="Background" Value="{StaticResource FailTintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FailBorderBrush}" />
    </Style>

    <Style Selector="Border.boardTile TextBlock.tilePercent">
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
    </Style>
    <Style Selector="Border.boardTile.ok TextBlock.tilePercent">
        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="Border.boardTile.failing TextBlock.tilePercent">
        <Setter Property="Foreground" Value="{StaticResource FailStrongBrush}" />
    </Style>
    <Style Selector="Border.boardTile.partial TextBlock.tilePercent">
        <Setter Property="Foreground" Value="{StaticResource WaitBrush}" />
    </Style>

    <Style Selector="Border.boardTile TextBlock.tileStatus">
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    </Style>
    <Style Selector="Border.boardTile.ok TextBlock.tileStatus">
        <Setter Property="Foreground" Value="{StaticResource OkTextBrush}" />
    </Style>
    <Style Selector="Border.boardTile.failing TextBlock.tileStatus">
        <Setter Property="Foreground" Value="{StaticResource FailTextBrush}" />
    </Style>
    <Style Selector="Border.boardTile.partial TextBlock.tileStatus">
        <Setter Property="Foreground" Value="{StaticResource WaitTextBrush}" />
    </Style>

    <!-- Telemetry rail card. Same surface either layout, different padding. -->
    <Style Selector="Border.railCard">
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.railCard.panel">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="24,22" />
    </Style>

    <!-- Mono section label. One step larger and wider-tracked than the station screen's. -->
    <Style Selector="TextBlock.railLabel">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.68" />
        <Setter Property="Foreground" Value="{StaticResource TextFainterBrush}" />
    </Style>

    <!--
        The techdesk's only buttons. Quiet on purpose: nothing here should compete with a red
        station card for attention.
    -->
    <Style Selector="Button.quiet">
        <Setter Property="Background" Value="{StaticResource Overlay06Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Overlay10Brush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Overlay08Brush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Overlay14Brush}" />
    </Style>

    <!-- Sits over a dashed Rectangle: "advisory / not yet real", the same as the gate card. -->
    <Style Selector="Button.quiet.dashed">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.quiet.dashed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Overlay03Brush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 1d's row action, sized to be pressable from a standing position. -->
    <Style Selector="Button.quiet.board">
        <Setter Property="Background" Value="{StaticResource Overlay06Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Overlay14Brush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="22,13" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A scrollbar someone can actually see and grab, rather than the default hairline. -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="{StaticResource Overlay02Brush}" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Border#TrackRect">
        <Setter Property="Background" Value="{StaticResource Overlay02Brush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb">
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb /template/ Border">
        <Setter Property="Background" Value="{StaticResource Overlay20Brush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- ==== Inputs ==== -->

    <Style Selector="TextBox.field">
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ActionBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CaretBrush" Value="{StaticResource ActionBrush}" />
    </Style>
    <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ActionBrush}" />
    </Style>
    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ActionBrush}" />
    </Style>
</Styles>
