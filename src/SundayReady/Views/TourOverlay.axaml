<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SundayReady.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SundayReady.Views.TourOverlay"
             x:DataType="vm:TourViewModel">

    <!-- No Background on the control or the Canvas: anything not covered by a child is not
         hit-testable, which is what lets clicks reach the one control being spotlit while the
         dimmed panels swallow everything else. -->
    <Canvas x:Name="Root">

        <!-- Four panels around the hole rather than a masked shape. A real cutout would need a
             geometry that is hit-test-transparent in the middle, and four rectangles get the
             same look while making "clicks pass through the hole and nowhere else" fall out of
             the layout instead of out of hit-test trickery. -->
        <Rectangle x:Name="DimTop" Fill="{StaticResource ScrimBrush}" />
        <Rectangle x:Name="DimLeft" Fill="{StaticResource ScrimBrush}" />
        <Rectangle x:Name="DimRight" Fill="{StaticResource ScrimBrush}" />
        <Rectangle x:Name="DimBottom" Fill="{StaticResource ScrimBrush}" />

        <Border x:Name="Ring" IsHitTestVisible="False" CornerRadius="7" BorderThickness="2"
                BorderBrush="{StaticResource ActionBrush}" />

        <!-- Always reachable, whatever the step is doing. -->
        <Border x:Name="SkipBar" Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                CornerRadius="0,0,9,9" Padding="18,10">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Classes="mono" Text="GUIDED TOUR" FontSize="11" FontWeight="SemiBold"
                           LetterSpacing="1.3" VerticalAlignment="Center"
                           Foreground="{StaticResource TextFainterBrush}" />
                <TextBlock Classes="mono" Text="{Binding CounterLabel}" FontSize="11"
                           FontWeight="SemiBold" LetterSpacing="1.3" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Button Classes="quiet" Content="Skip tour" Padding="12,5" FontSize="13"
                        Command="{Binding SkipCommand}" />
            </StackPanel>
        </Border>

        <Border x:Name="Callout" Width="380" Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource Overlay22Brush}" BorderThickness="1"
                CornerRadius="10" Padding="22,20" BoxShadow="0 10 34 0 #B0000000">
            <StackPanel Spacing="13">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Body}" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDimBrush}" />

                <!-- Shown only while the step is waiting for the real control to be pressed. -->
                <Border IsVisible="{Binding HasPrompt}" CornerRadius="6" Padding="12,9"
                        Background="{StaticResource Overlay06Brush}">
                    <TextBlock Text="{Binding Prompt}" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" Foreground="{StaticResource ActionBrush}" />
                </Border>

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3,0,0">
                    <Button Grid.Column="0" Classes="quiet" Content="Back" Padding="12,7"
                            FontSize="13" IsVisible="{Binding CanGoBack}"
                            Command="{Binding BackCommand}" />
                    <!-- On a click step the real control is the way forward, so Next would be a
                         second, easier answer to the question the step is asking. -->
                    <Button Grid.Column="2" Classes="primary" Content="{Binding NextLabel}"
                            Padding="20,9" FontSize="14" CornerRadius="6"
                            IsVisible="{Binding !WaitsForClick}"
                            Command="{Binding NextCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Canvas>
</UserControl>
