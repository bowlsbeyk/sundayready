<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SundayReady.ViewModels"
        xmlns:views="using:SundayReady.Views"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="SundayReady.Views.MainWindow"
        x:DataType="vm:StationViewModel"
        Title="SundayReady"
        Icon="/Assets/logo.png"
        Width="1600" Height="960"
        MinWidth="1280" MinHeight="760"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <views:StationView />

        <!-- Last child, so the spotlight sits over everything. Hidden until a tour runs. -->
        <views:TourOverlay x:Name="TourLayer" IsVisible="False" />
    </Grid>
</Window>
