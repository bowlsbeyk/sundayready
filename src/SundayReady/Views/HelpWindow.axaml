<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SundayReady.ViewModels"
        xmlns:svc="using:SundayReady.Services"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="820"
        x:Class="SundayReady.Views.HelpWindow"
        x:DataType="vm:HelpViewModel"
        Title="How SundayReady works"
        Icon="/Assets/logo.png"
        Width="900" Height="820"
        MinWidth="700" MinHeight="560"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.h">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="23" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.tag">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        </Style>
        <Style Selector="Border.entry">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="64,Auto,*">

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,16,Auto" Margin="28,0">
                <TextBlock Grid.Column="0" Classes="screenTitle" Text="How SundayReady works"
                           VerticalAlignment="Center" />

                <!-- Reading about the app and being shown it are different things, and this is
                     where someone ends up when the reading is not landing. -->
                <Button Grid.Column="2" Classes="secondary" Content="Show me around"
                        VerticalAlignment="Center" Click="OnTourClick" />
                <TextBlock Grid.Column="4" Classes="mono" Text="{Binding Version}" FontSize="11"
                           Foreground="{StaticResource TextFainterBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid ColumnDefinitions="*,14,Auto,10,Auto">
                <TextBox Grid.Column="0" Classes="field" FontSize="15" Margin="0"
                         Text="{Binding Query, Mode=TwoWay}"
                         Watermark="Search — try “red”, “override”, “vmix”, “ready”" />
                <TextBlock Grid.Column="2" Classes="mono" Text="{Binding ResultLabel}" FontSize="12"
                           VerticalAlignment="Center" IsVisible="{Binding HasQuery}"
                           Foreground="{StaticResource TextFaintBrush}" />
                <Button Grid.Column="4" Classes="quiet" Content="Clear" Padding="12,7"
                        VerticalAlignment="Center" IsVisible="{Binding HasQuery}"
                        Command="{Binding ClearQueryCommand}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" AllowAutoHide="False">
            <StackPanel Margin="28,24,28,48" Spacing="26">

                <TextBlock Classes="body" Text="{Binding Intro}" IsVisible="{Binding ShowIntro}" />

                <Border Classes="entry" IsVisible="{Binding HasNoResults}">
                    <StackPanel Spacing="7">
                        <TextBlock Classes="h" Text="Nothing matches that" />
                        <TextBlock Classes="body"
                                   Text="Try a single word — the name of a button, or what is going wrong. Clear the search to read the whole thing." />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12" IsVisible="{Binding HasItemTypes}">
                    <TextBlock Classes="microLabel" Text="THE THREE KINDS OF ITEM" />
                    <ItemsControl ItemsSource="{Binding ItemTypes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="svc:Topic">
                                <Border Classes="entry">
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="mono" Text="{Binding Title}" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ActionBrush}" />
                                        <TextBlock Classes="body" Text="{Binding Body}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Grouped, and in the order somebody needs them: using it, then when it goes
                     wrong, then setting one up, then admin. -->
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="26" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:HelpSectionViewModel">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="microLabel" Text="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Topics}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="svc:Topic">
                                            <Border Classes="entry">
                                                <StackPanel Spacing="7">
                                                    <TextBlock Classes="h" Text="{Binding Title}" />
                                                    <TextBlock Classes="body" Text="{Binding Body}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="12" IsVisible="{Binding HasVerifiers}">
                    <TextBlock Classes="microLabel" Text="WHAT THE APP CAN CHECK FOR ITSELF" />
                    <ItemsControl ItemsSource="{Binding Verifiers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="svc:VerifierGuide">
                                <Border Classes="entry">
                                    <StackPanel Spacing="9">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Kind}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ActionBrush}" />
                                            <TextBlock Grid.Column="1" Classes="tag" Text="NOT BUILT YET"
                                                       HorizontalAlignment="Right"
                                                       IsVisible="{Binding IsStub}"
                                                       Foreground="{StaticResource WaitBrush}" />
                                        </Grid>
                                        <TextBlock Classes="h" Text="{Binding Headline}" />
                                        <TextBlock Classes="body" Text="{Binding What}" />
                                        <TextBlock Classes="body" Text="{Binding WhenToUse}"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                        <Border Background="{StaticResource BgBrush}" CornerRadius="6"
                                                Padding="12,10">
                                            <TextBlock Classes="mono" Text="{Binding Example}" FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </Border>
                                        <TextBlock Classes="body" FontSize="14" Text="{Binding Gotcha}"
                                                   IsVisible="{Binding Gotcha, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="{StaticResource WaitTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
