<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SundayReady.ViewModels"
        xmlns:svc="using:SundayReady.Services"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="820"
        x:Class="SundayReady.Views.HelpWindow"
        x:DataType="vm:HelpViewModel"
        Title="How SundayReady works"
        Icon="/Assets/logo.png"
        Width="900" Height="820"
        MinWidth="700" MinHeight="560"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.h">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="23" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.tag">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        </Style>
        <Style Selector="Border.entry">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="64,*">

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*" Margin="28,0">
                <TextBlock Grid.Column="0" Classes="screenTitle" Text="How SundayReady works"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Version}" FontSize="11"
                           Foreground="{StaticResource TextFainterBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" AllowAutoHide="False">
            <StackPanel Margin="28,24,28,48" Spacing="26">

                <TextBlock Classes="body" Text="{Binding Intro}" />

                <StackPanel Spacing="12">
                    <TextBlock Classes="microLabel" Text="THE THREE KINDS OF ITEM" />
                    <ItemsControl ItemsSource="{Binding ItemTypes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="svc:Topic">
                                <Border Classes="entry">
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="mono" Text="{Binding Title}" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ActionBrush}" />
                                        <TextBlock Classes="body" Text="{Binding Body}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Classes="microLabel" Text="WHAT THE APP CAN CHECK FOR ITSELF" />
                    <ItemsControl ItemsSource="{Binding Verifiers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="svc:VerifierGuide">
                                <Border Classes="entry">
                                    <StackPanel Spacing="9">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Kind}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ActionBrush}" />
                                            <TextBlock Grid.Column="1" Classes="tag" Text="NOT BUILT YET"
                                                       HorizontalAlignment="Right"
                                                       IsVisible="{Binding IsStub}"
                                                       Foreground="{StaticResource WaitBrush}" />
                                        </Grid>
                                        <TextBlock Classes="h" Text="{Binding Headline}" />
                                        <TextBlock Classes="body" Text="{Binding What}" />
                                        <TextBlock Classes="body" Text="{Binding WhenToUse}"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                        <Border Background="{StaticResource BgBrush}" CornerRadius="6"
                                                Padding="12,10">
                                            <TextBlock Classes="mono" Text="{Binding Example}" FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </Border>
                                        <TextBlock Classes="body" FontSize="14" Text="{Binding Gotcha}"
                                                   IsVisible="{Binding Gotcha, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="{StaticResource WaitTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Classes="microLabel" Text="WORTH KNOWING" />
                    <ItemsControl ItemsSource="{Binding Concepts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="svc:Topic">
                                <Border Classes="entry">
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="h" Text="{Binding Title}" />
                                        <TextBlock Classes="body" Text="{Binding Body}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
