<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SundayReady.ViewModels"
             xmlns:controls="using:SundayReady.Controls"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="SundayReady.Views.TechdeskColumnsView"
             x:DataType="vm:TechdeskViewModel">

    <!-- 1c. A column per station plus a telemetry rail: the layout for a techdesk that is
         worked in rather than glanced at. -->

    <UserControl.Styles>
        <!-- Summary pill. Amber while anything is outstanding, red once something is failing. -->
        <Style Selector="Border.summary">
            <Setter Property="Background" Value="{StaticResource WaitPillFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WaitPillBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="13,7" />
        </Style>
        <Style Selector="Border.summary.ok">
            <Setter Property="Background" Value="{StaticResource OkFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OkTintBorderStrongBrush}" />
        </Style>
        <Style Selector="Border.summary.failing">
            <Setter Property="Background" Value="{StaticResource FailPillFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FailPillBorderBrush}" />
        </Style>
        <Style Selector="Border.summary TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WaitTextBrush}" />
        </Style>
        <Style Selector="Border.summary.ok TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OkTextBrush}" />
        </Style>
        <Style Selector="Border.summary.failing TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FailTextBrush}" />
        </Style>

        <!-- Device chip. Only station PCs appear here; they are what heartbeats prove. -->
        <Style Selector="Border.deviceChip">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,11" />
        </Style>
        <Style Selector="Border.deviceChip.idle">
            <Setter Property="Background" Value="{StaticResource WaitTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WaitBorderBrush}" />
        </Style>
        <Style Selector="Border.deviceChip.down">
            <Setter Property="Background" Value="{StaticResource FailTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FailTintBorderBrush}" />
        </Style>
        <Style Selector="Border.deviceChip Ellipse">
            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="Border.deviceChip.idle Ellipse">
            <Setter Property="Fill" Value="{StaticResource WaitBrush}" />
        </Style>
        <Style Selector="Border.deviceChip.down Ellipse">
            <Setter Property="Fill" Value="{StaticResource FailBrush}" />
        </Style>
        <Style Selector="Border.deviceChip TextBlock.deviceDetail">
            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
        </Style>
        <Style Selector="Border.deviceChip.idle TextBlock.deviceDetail">
            <Setter Property="Foreground" Value="{StaticResource WaitTextBrush}" />
        </Style>
        <Style Selector="Border.deviceChip.down TextBlock.deviceDetail">
            <Setter Property="Foreground" Value="{StaticResource FailDimBrush}" />
        </Style>

        <!-- A completed preview line, and one still open. -->
        <Style Selector="TextBlock.previewGlyph">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
            <Setter Property="Width" Value="14" />
        </Style>
        <Style Selector="TextBlock.previewGlyph.done">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource BgBrush}" RowDefinitions="80,*">

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="32,0">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Classes="wordmark" Text="SundayReady" />
                    <TextBlock Classes="wordmark" Text="Techdesk" FontWeight="Normal"
                               Foreground="{StaticResource TextFaintBrush}" />
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="32" Margin="20,0"
                           Fill="{StaticResource Overlay09Brush}" VerticalAlignment="Center" />

                <Border Grid.Column="2" Classes="summary"
                        Classes.ok="{Binding SummaryIsOk}"
                        Classes.failing="{Binding SummaryIsFailing}"
                        VerticalAlignment="Center">
                    <TextBlock Classes="mono" Text="{Binding SummaryText}" FontSize="12" FontWeight="SemiBold" />
                </Border>

                <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Classes="microLabel" Text="SERVICE IN" LetterSpacing="1.32"
                               HorizontalAlignment="Right" />
                    <TextBlock Classes="mono" Text="{Binding Countdown}" FontSize="34" FontWeight="SemiBold"
                               LetterSpacing="-1.02" Foreground="{StaticResource WaitBrush}"
                               HorizontalAlignment="Right" />
                </StackPanel>

                <Rectangle Grid.Column="5" Width="1" Height="44" Margin="26,0"
                           Fill="{StaticResource Overlay09Brush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="6" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Classes="mono" Text="{Binding Clock}" FontSize="30" FontWeight="SemiBold"
                               LetterSpacing="-0.6" HorizontalAlignment="Right" />
                    <TextBlock Classes="mono" Text="{Binding DateLine}" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource TextFainterBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,436">

            <!-- Station columns. The 7px item margin makes the 14px gutter the design asks for. -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Stations}" Margin="17,15">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TechdeskStationViewModel">
                        <Border Classes="stationCard" Classes.failing="{Binding IsFailing}" Margin="7">
                            <Grid RowDefinitions="Auto,*">

                                <Border Grid.Row="0" Classes="stationHeader"
                                        Classes.ok="{Binding IsReady}"
                                        Classes.failing="{Binding IsFailing}"
                                        Classes.partial="{Binding IsInProgress}">
                                    <StackPanel Spacing="9">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="17"
                                                       FontWeight="SemiBold" LineHeight="20.4"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Ellipse Grid.Column="1" Classes="statusDot" Width="11" Height="11"
                                                     Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Classes="mono" Text="{Binding HostLine}" FontSize="11"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextFainterBrush}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="mono stationFigure" Text="{Binding CountText}"
                                                       FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.9" />
                                            <TextBlock Classes="mono stationFigure" Text="{Binding StatusText}"
                                                       FontSize="12" FontWeight="SemiBold" LetterSpacing="1.44"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                        </StackPanel>

                                        <controls:SegmentBar Height="5"
                                                             CompletedFraction="{Binding CompletedFraction}"
                                                             FailingFraction="{Binding FailingFraction}"
                                                             IsHealthy="{Binding IsReady}"
                                                             TrackBrush="{StaticResource Overlay08Brush}"
                                                             OkBrush="{StaticResource OkBrush}"
                                                             WaitBrush="{StaticResource WaitBrush}"
                                                             FailBrush="{StaticResource FailBrush}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="18,14" Spacing="9">

                                    <!-- A failing station leads with what is broken, not with what is done. -->
                                    <Border IsVisible="{Binding HasCallout}" CornerRadius="6" Padding="12,10"
                                            Background="{StaticResource FailPillFillBrush}"
                                            BorderBrush="{StaticResource FailTintBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CalloutTitle}" FontSize="13" FontWeight="SemiBold"
                                                       LineHeight="17" TextWrapping="Wrap"
                                                       Foreground="{StaticResource FailBodyBrush}" />
                                            <TextBlock Classes="mono" Text="{Binding CalloutDetail}" FontSize="11"
                                                       LineHeight="15.4" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Foreground="{StaticResource FailDimBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Preview}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="9" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:TechdeskPreviewItemViewModel">
                                                <Grid ColumnDefinitions="Auto,10,*">
                                                    <TextBlock Grid.Column="0" Classes="previewGlyph"
                                                               Classes.done="{Binding IsDone}"
                                                               Text="{Binding Glyph}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="14"
                                                               LineHeight="18.9" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextFaintBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Classes="mono" IsVisible="{Binding HasMore}" Text="{Binding MoreText}"
                                               FontSize="12" Margin="0,-5,0,0"
                                               Foreground="{StaticResource TextDisabledBrush}" />

                                    <!-- Not staffed: no progress to show, only two things to do about it. -->
                                    <StackPanel IsVisible="{Binding IsSilent}" Spacing="11">
                                        <TextBlock Classes="railBody" FontSize="14" LineHeight="21"
                                                   Text="{Binding SilentExplanation}"
                                                   Foreground="{StaticResource TextFaintBrush}" />

                                        <StackPanel IsVisible="{Binding ShowNotStaffedActions}" Spacing="9">
                                            <Button Classes="quiet" Content="Page the volunteer"
                                                    Command="{Binding PageCommand}" />
                                            <Grid>
                                                <Rectangle RadiusX="6" RadiusY="6"
                                                           Fill="{StaticResource Overlay02Brush}"
                                                           Stroke="{StaticResource HairlineDashedBrush}"
                                                           StrokeThickness="1" StrokeDashArray="4,3" />
                                                <Button Classes="quiet dashed" Content="Mark not staffed today"
                                                        Command="{Binding MarkNotStaffedCommand}" />
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Classes="mono" IsVisible="{Binding HasActionStatus}"
                                                   Text="{Binding ActionStatus}" FontSize="11" LineHeight="16"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextDisabledBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Telemetry rail -->
            <Border Grid.Column="1" Background="{StaticResource RailBgBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,22">

                    <StackPanel Grid.Row="0" Spacing="10">
                        <TextBlock Classes="railLabel" Text="LIVESTREAM AUDIENCE" />
                        <Grid ColumnDefinitions="*,10,*">
                            <Border Grid.Column="0" Classes="railCard" Padding="16,15">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="mono" Text="YOUTUBE" FontSize="11" FontWeight="Medium"
                                               Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBlock Classes="mono" Text="{Binding YouTubeCount}" FontSize="40"
                                               FontWeight="SemiBold" LetterSpacing="-1.2" />
                                    <TextBlock Classes="mono" Text="NO FEED" FontSize="11"
                                               Foreground="{StaticResource TextDisabledBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="railCard" Padding="16,15">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="mono" Text="FACEBOOK" FontSize="11" FontWeight="Medium"
                                               Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBlock Classes="mono" Text="{Binding FacebookCount}" FontSize="40"
                                               FontWeight="SemiBold" LetterSpacing="-1.2" />
                                    <TextBlock Classes="mono" Text="NO FEED" FontSize="11"
                                               Foreground="{StaticResource TextDisabledBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Classes="railCard" Padding="16,13">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Peak last Sunday" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding PeakLastWeek}" FontSize="17"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="10" Margin="0,16,0,0">
                        <TextBlock Classes="railLabel" Text="NETWORK" />
                        <Border Classes="railCard">
                            <StackPanel Spacing="13">
                                <!-- Figure and unit are runs of one TextBlock so they share a
                                     baseline: bottom-aligning two elements puts an em-dash
                                     placeholder half a line above its unit. -->
                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="mono" Text="DOWN" FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Classes="mono" FontSize="26" FontWeight="SemiBold">
                                            <Run Text="{Binding DownText}" />
                                            <Run Text=" Mb/s" FontSize="13"
                                                 Foreground="{StaticResource TextFaintBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="mono" Text="UP" FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Classes="mono" FontSize="26" FontWeight="SemiBold">
                                            <Run Text="{Binding UpText}" />
                                            <Run Text=" Mb/s" FontSize="13"
                                                 Foreground="{StaticResource TextFaintBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="mono" Text="PING" FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Classes="mono" FontSize="26" FontWeight="SemiBold">
                                            <Run Text="{Binding PingText}" />
                                            <Run Text=" ms" FontSize="13"
                                                 Foreground="{StaticResource TextFaintBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Bars only once there is something measured to draw. -->
                                <controls:Sparkline Height="44" IsVisible="{Binding HasSamples}"
                                                    Samples="{Binding PingSamples}" MaxBars="12" RecentBars="5"
                                                    BarBrush="{StaticResource Overlay13Brush}"
                                                    RecentBrush="{StaticResource ActionBrush}" />
                                <Grid Height="44" IsVisible="{Binding !HasSamples}">
                                    <Rectangle RadiusX="4" RadiusY="4" Fill="{StaticResource Overlay02Brush}"
                                               Stroke="{StaticResource HairlineDashedBrush}" StrokeThickness="1"
                                               StrokeDashArray="4,3" />
                                    <TextBlock Classes="mono" Text="NO SAMPLES YET" FontSize="11"
                                               Foreground="{StaticResource TextDisabledBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Classes="mono" Text="{Binding SparklineCaption}" FontSize="11"
                                           TextWrapping="Wrap" LineHeight="15"
                                           Foreground="{StaticResource TextDisabledBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,0" VerticalAlignment="Top">
                        <TextBlock Classes="railLabel" Text="DEVICES" />
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TechdeskDeviceViewModel">
                                    <Border Classes="deviceChip" Classes.idle="{Binding IsIdle}"
                                            Classes.down="{Binding IsDown}" Margin="0,0,8,8">
                                        <Grid ColumnDefinitions="Auto,9,*,Auto">
                                            <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13"
                                                       FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Classes="mono deviceDetail"
                                                       Text="{Binding Detail}" FontSize="10" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Spacing="4" Margin="0,16,0,0">
                        <TextBlock Classes="mono" Text="{Binding SweepLine}" FontSize="11"
                                   Foreground="{StaticResource TextDisabledBrush}" />
                        <TextBlock Classes="mono" Text="{Binding ShareLine}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextLockedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
