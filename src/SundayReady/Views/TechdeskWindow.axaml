<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SundayReady.ViewModels"
        xmlns:views="using:SundayReady.Views"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="SundayReady.Views.TechdeskWindow"
        x:DataType="vm:TechdeskViewModel"
        Title="SundayReady Techdesk"
        Icon="/Assets/logo.png"
        Width="1920" Height="1080"
        MinWidth="1280" MinHeight="800"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <!-- Both layouts are built and the choice lives in station.json, so the tech director can
         try each one on the actual display rather than deciding from a mockup. -->
    <Panel>
        <views:TechdeskColumnsView IsVisible="{Binding IsColumnsLayout}" />
        <views:TechdeskBoardView IsVisible="{Binding IsBoardLayout}" />
    </Panel>
</Window>
