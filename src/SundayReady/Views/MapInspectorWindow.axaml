<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SundayReady.ViewModels"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="700"
        x:Class="SundayReady.Views.MapInspectorWindow"
        x:DataType="vm:MapInspectorViewModel"
        Title="Device"
        Icon="/Assets/logo.png"
        Width="820" SizeToContent="Height"
        MaxHeight="900"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.colHead">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.25" />
            <Setter Property="Foreground" Value="{StaticResource TextFainterBrush}" />
        </Style>
        <Style Selector="Border.hop">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Width" Value="170" />
        </Style>
        <Style Selector="Border.hop.broken">
            <Setter Property="Background" Value="{StaticResource FailFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FailBorderBrush}" />
        </Style>
        <!-- Starved hops go hollow and dashed rather than red: they are not broken. -->
        <Style Selector="Border.hop.starvedHop">
            <Setter Property="Background" Value="{StaticResource Overlay02Brush}" />
            <Setter Property="BorderBrush" Value="#2BFFFFFF" />
        </Style>
    </Window.Styles>

    <ScrollViewer AllowAutoHide="False">
        <StackPanel Margin="28,24,28,28" Spacing="18">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,16,*,Auto">
                <Border Width="40" Height="40" CornerRadius="9"
                        Background="{StaticResource NodeHubBrush}"
                        BorderBrush="{StaticResource BorderHubBrush}" BorderThickness="1.5">
                    <TextBlock Classes="mono" Text="{Binding KindGlyph}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Classes="mono" Text="{Binding Meta}" FontSize="11.5"
                               Foreground="{StaticResource TextFainterBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Border CornerRadius="20" Padding="11,5" Background="#1F4ec27f"
                            IsVisible="{Binding Device.ShowsOk}">
                        <TextBlock Classes="mono" Text="REACHABLE" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource OkBrush}" />
                    </Border>
                    <Border CornerRadius="20" Padding="11,5"
                            Background="{StaticResource FailPillFillBrush}"
                            IsVisible="{Binding Device.ShowsFailure}">
                        <TextBlock Classes="mono" Text="{Binding Device.FailBadge}" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource FailTagBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Connections table -->
            <StackPanel Spacing="9" IsVisible="{Binding HasRows}">
                <TextBlock Classes="microLabel" Text="CONNECTIONS" />
                <Grid ColumnDefinitions="34,96,*,120,64" Margin="4,0">
                    <TextBlock Classes="colHead" Text="DIR" />
                    <TextBlock Grid.Column="1" Classes="colHead" Text="STATE" />
                    <TextBlock Grid.Column="2" Classes="colHead" Text="GOES TO / FED BY" />
                    <TextBlock Grid.Column="3" Classes="colHead" Text="TYPE" />
                    <TextBlock Grid.Column="4" Classes="colHead" Text="RUN" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:MapInspectorRowViewModel">
                            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="4,9">
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="34,96,*,120,64">
                                        <TextBlock Classes="mono" Text="{Binding Direction}" FontSize="10.5"
                                                   Foreground="{StaticResource TextFainterBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding State}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Classes.failText="{Binding IsDown}" />
                                        <TextBlock Grid.Column="2" Text="{Binding OtherEnd}"
                                                   FontSize="14.5" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7"
                                                    VerticalAlignment="Center">
                                            <Border Width="9" Height="9" CornerRadius="2.5"
                                                    Background="{Binding TypeColour}" />
                                            <TextBlock Classes="mono" Text="{Binding TypeName}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Classes="mono" Text="{Binding Run}"
                                                   FontSize="11.5" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </Grid>

                                    <!-- The seam with the checklist. -->
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsUnverified}">
                                        <TextBlock Classes="mono" FontSize="10.5"
                                                   Foreground="{StaticResource WaitBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="DOCUMENTED BUT NEVER VERIFIED — NO CHECK EXISTS YET" />
                                        <Button Grid.Column="1" Classes="quiet" FontSize="12" Padding="10,5"
                                                Content="Make this a checklist item"
                                                Command="{Binding $parent[Window].((vm:MapInspectorViewModel)DataContext).MakeChecklistItemCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                    <TextBlock FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               Text="{Binding BridgeStatus}"
                                               IsVisible="{Binding HasBridgeStatus}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="Auto,10,Auto" IsVisible="{Binding HasUnverified}">
                    <TextBlock Classes="mono" Text="NEW ITEMS GO TO" FontSize="10.5"
                               Foreground="{StaticResource TextFainterBrush}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2" MinWidth="220" ItemsSource="{Binding ChecklistFiles}"
                              SelectedItem="{Binding BridgeTargetFile, Mode=TwoWay}" />
                </Grid>
            </StackPanel>

            <!-- The path onward: 2e's readable-in-three-seconds strip. -->
            <StackPanel Spacing="9" IsVisible="{Binding HasTrace}">
                <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                <TextBlock Classes="mono" Text="{Binding TraceTitle}" FontSize="11.5" FontWeight="SemiBold"
                           LetterSpacing="1" Foreground="{StaticResource TextFaintBrush}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Trace}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:MapTraceHopViewModel">
                                <Border Classes="hop"
                                        Classes.broken="{Binding IsBroken}"
                                        Classes.starvedHop="{Binding IsStarvedHop}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding Label}" FontSize="14"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="mono" Text="{Binding Detail}" FontSize="10"
                                                   Foreground="{StaticResource TextFainterBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="mono" Text="{Binding StateLine}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Classes.failText="{Binding IsBroken}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Classes="card" Padding="14,11" IsVisible="{Binding HasTraceVerdict}"
                        BorderBrush="{StaticResource WaitBorderBrush}">
                    <TextBlock FontSize="13.5" LineHeight="20" TextWrapping="Wrap"
                               Text="{Binding TraceVerdict}"
                               Foreground="{StaticResource TextDimBrush}" />
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Grid ColumnDefinitions="Auto,10,Auto,*,Auto">
                <Button Classes="primary" Content="Check now" Padding="17,9"
                        IsVisible="{Binding Device.HasVerify}"
                        Command="{Binding CheckNowCommand}" />
                <Button Grid.Column="2" Classes="secondary" Content="Close" Padding="17,9"
                        Click="OnCloseClick" />
                <TextBlock Grid.Column="4" Classes="mono" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDisabledBrush}" TextWrapping="Wrap"
                           Text="{Binding Status}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
