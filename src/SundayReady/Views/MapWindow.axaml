<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SundayReady.ViewModels"
        xmlns:views="using:SundayReady.Views"
        xmlns:models="using:SundayReady.Models"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="SundayReady.Views.MapWindow"
        x:DataType="vm:MapWorkspaceViewModel"
        Title="System map"
        Icon="/Assets/logo.png"
        Width="1600" Height="960"
        MinWidth="1180" MinHeight="720"
        WindowState="Maximized"
        Background="{StaticResource MapBgBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <!-- Ctrl+Z everywhere, Cmd+Z on a Mac. Delete needs no modifier: the map is a canvas,
             not a text field, and there is nothing else Delete could plausibly mean here. -->
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Cmd+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Gesture="Back" Command="{Binding DeleteSelectedCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- A room with a fault, and the one hop on the stream path that owns the alarm. -->
        <Style Selector="Border.roomFail">
            <Setter Property="Background" Value="{StaticResource FailFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FailBorderBrush}" />
        </Style>
        <Style Selector="Border.hopBreak">
            <Setter Property="Background" Value="{StaticResource FailFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FailBorderBrush}" />
        </Style>
        <Style Selector="Border.hopStarved">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- Notes: a bare text field that only looks like a field once you are editing. -->
        <Style Selector="TextBox.noteText">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Border.warn">
            <Setter Property="Background" Value="{StaticResource NoteWarnFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NoteWarnEdgeBrush}" />
        </Style>
        <Style Selector="Border.picked">
            <Setter Property="BorderBrush" Value="{StaticResource ActionBrush}" />
        </Style>

        <!-- Node hierarchy is expressed by surface, not size — every node is the same box. -->
        <Style Selector="Rectangle.nodeFace">
            <Setter Property="Fill" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="Stroke" Value="{StaticResource BorderNodeBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="RadiusX" Value="8" />
            <Setter Property="RadiusY" Value="8" />
        </Style>
        <Style Selector="Panel.hub Rectangle.nodeFace">
            <Setter Property="Fill" Value="{StaticResource NodeHubBrush}" />
            <Setter Property="Stroke" Value="{StaticResource BorderHubBrush}" />
        </Style>
        <!-- Inferred: faint fill, dashed border. "Probably fine" must never look "checked". -->
        <Style Selector="Panel.inferred Rectangle.nodeFace">
            <Setter Property="Fill" Value="{StaticResource Overlay02Brush}" />
            <Setter Property="Stroke" Value="#2BFFFFFF" />
            <Setter Property="StrokeDashArray" Value="3,3" />
        </Style>
        <Style Selector="Panel.fail Rectangle.nodeFace">
            <Setter Property="Fill" Value="{StaticResource FailFillBrush}" />
            <Setter Property="Stroke" Value="{StaticResource FailBorderBrush}" />
        </Style>
        <Style Selector="Panel.picked Rectangle.nodeFace">
            <Setter Property="Stroke" Value="{StaticResource ActionBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeDashArray" Value="" />
        </Style>

        <Style Selector="TextBlock.nodeTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Panel.hub TextBlock.nodeTitle">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Panel.inferred TextBlock.nodeTitle">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style Selector="TextBlock.nodeSub">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource TextFainterBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Panel.fail TextBlock.nodeSub">
            <Setter Property="Foreground" Value="{StaticResource FailTextBrush}" />
        </Style>

        <Style Selector="Panel.dimmed">
            <Setter Property="Opacity" Value="0.15" />
        </Style>

        <Style Selector="TextBlock.tierBadge">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.95" />
        </Style>

        <Style Selector="Button.segment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.segment.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Overlay09Brush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style Selector="Button.legendRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.legendRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Overlay04Brush}" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="{StaticResource TextFainterBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style Selector="TextBlock.failText">
            <Setter Property="Foreground" Value="{StaticResource FailTextBrush}" />
        </Style>
        <Style Selector="Button.legendRow.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Overlay08Brush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="80,*">

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,26,Auto,18,Auto,*,Auto,11,Auto,26,Auto" Margin="26,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Classes="wordmark" Text="SundayReady" />
                    <TextBlock Text="{Binding Title}" FontSize="19"
                               Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Three projections of one dataset, not three drawings. -->
                <Border Grid.Column="2" Background="{StaticResource Overlay04Brush}" CornerRadius="8"
                        Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="segment" Content="Signal flow"
                                Classes.active="{Binding IsSignalFlow}"
                                Command="{Binding ShowViewCommand}" CommandParameter="flow"
                                ToolTip.Tip="What feeds what." />
                        <Button Classes="segment" Content="Building"
                                Classes.active="{Binding IsBuilding}"
                                Command="{Binding ShowViewCommand}" CommandParameter="building"
                                ToolTip.Tip="The same gear, grouped by the room it lives in. Rooms with a fault come first." />
                        <Button Classes="segment" Content="Stream path"
                                Classes.active="{Binding IsStreamPath}"
                                Command="{Binding ShowViewCommand}" CommandParameter="stream"
                                ToolTip.Tip="The chain signal takes on its way out of the building, and where it stops." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{StaticResource FailPillFillBrush}"
                        BorderBrush="{StaticResource FailPillBorderBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="13,6" VerticalAlignment="Center"
                        IsVisible="{Binding Current.HasLinksDown, FallbackValue=False}">
                    <TextBlock Classes="mono" Text="{Binding Current.LinksDownLabel, FallbackValue=''}"
                               FontSize="11" FontWeight="SemiBold" LetterSpacing="0.8"
                               Foreground="{StaticResource FailTagBrush}" />
                </Border>

                <!-- The edit-mode tools travel together, so adding one never means renumbering
                     every column after it. -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="11"
                            VerticalAlignment="Center" IsVisible="{Binding IsEditing}">
                    <Button Classes="quiet" Content="Add device" Click="OnAddDeviceClick" />
                    <Button Classes="quiet" Content="Add note" Click="OnAddNoteClick"
                            ToolTip.Tip="Pins a note to the canvas. Select a box first and the note attaches to it, and follows it around." />
                    <Button Classes="quiet" Content="Draw connection"
                            Command="{Binding BeginWireCommand}"
                            ToolTip.Tip="Arms a wire from the selected box. You can also just drag from either end of a box." />
                    <Button Classes="quiet" Content="Undo"
                            Command="{Binding UndoCommand}"
                            IsEnabled="{Binding CanUndo}"
                            ToolTip.Tip="{Binding UndoLabel}" />
                </StackPanel>

                <Button Grid.Column="8" Classes="quiet dashed" VerticalAlignment="Center"
                        Command="{Binding ToggleEditingCommand}">
                    <TextBlock Text="Edit layout" />
                </Button>

                <TextBlock Grid.Column="10" x:Name="Clock" Classes="mono" FontSize="24"
                           FontWeight="SemiBold" LetterSpacing="-0.5" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,340">

            <!-- The graph -->
            <Panel Grid.Column="0">
                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto"
                              AllowAutoHide="False" IsVisible="{Binding IsSignalFlow}">
                    <Panel x:Name="GraphSurface"
                           Width="{Binding Current.CanvasWidth, FallbackValue=1500}"
                           Height="{Binding Current.CanvasHeight, FallbackValue=900}"
                           Background="Transparent"
                           PointerPressed="OnSurfacePressed">

                        <!-- Role-column bands: layout furniture that carries rank. -->
                        <ItemsControl ItemsSource="{Binding Current.ColumnBands, FallbackValue={x:Null}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="vm:MapColumnBand">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="24" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MapColumnBand">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="mono" Text="{Binding Label}" FontSize="11"
                                                   FontWeight="SemiBold" LetterSpacing="1.55"
                                                   Foreground="{StaticResource TextFainterBrush}"
                                                   Margin="16,0,0,0" />
                                        <Rectangle Width="242" Height="{Binding Height}"
                                                   Fill="#04FFFFFF" RadiusX="14" RadiusY="14" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Wires, behind the nodes, all drawn by one control from one clock. -->
                        <views:WireLayer x:Name="Wires"
                                         Connections="{Binding Current.Connections, FallbackValue={x:Null}}"
                                         Frozen="{Binding FreezeWires}" />

                        <!-- Notes. Above the wires so they are readable, below the boxes so a
                             note can never hide the thing it is talking about. -->
                        <ItemsControl ItemsSource="{Binding Current.Notes, FallbackValue={x:Null}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="vm:MapNoteViewModel">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MapNoteViewModel">
                                    <Panel PointerPressed="OnNotePressed"
                                           PointerMoved="OnNoteMoved"
                                           PointerReleased="OnNoteReleased"
                                           Opacity="{Binding IsDimmed, Converter={x:Static views:MapConverters.DimOpacity}}">
                                        <Border Width="210" MinHeight="46" CornerRadius="4"
                                                Padding="12,10"
                                                Background="{StaticResource NoteFillBrush}"
                                                BorderThickness="1,1,1,1"
                                                BorderBrush="{StaticResource NoteEdgeBrush}"
                                                Classes.warn="{Binding IsWarning}"
                                                Classes.picked="{Binding IsSelected}">
                                            <StackPanel Spacing="5">
                                                <TextBox Classes="noteText" AcceptsReturn="True"
                                                         TextWrapping="Wrap" FontSize="12.5"
                                                         Watermark="Type the thing somebody needs to know…"
                                                         Text="{Binding Text, Mode=TwoWay}"
                                                         IsReadOnly="{Binding !$parent[Window].((vm:MapWorkspaceViewModel)DataContext).IsEditing}" />
                                                <TextBlock Classes="mono" FontSize="10"
                                                           LetterSpacing="0.6"
                                                           Foreground="{StaticResource TextFainterBrush}"
                                                           Text="{Binding Author}"
                                                           IsVisible="{Binding HasAuthor}" />
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Nodes -->
                        <ItemsControl x:Name="Nodes"
                                      ItemsSource="{Binding Current.Devices, FallbackValue={x:Null}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="vm:MapDeviceViewModel">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MapDeviceViewModel">
                                    <Panel Width="210" Height="64"
                                           Classes.hub="{Binding IsHub}"
                                           Classes.inferred="{Binding IsInferred}"
                                           Classes.fail="{Binding ShowsFailure}"
                                           Classes.picked="{Binding IsSelected}"
                                           Classes.dimmed="{Binding IsDimmed}"
                                           PointerPressed="OnNodePressed"
                                           PointerMoved="OnNodeMoved"
                                           PointerReleased="OnNodeReleased"
                                           DoubleTapped="OnNodeDoubleTapped"
                                           Background="Transparent">
                                        <Rectangle Classes="nodeFace" />

                                        <!-- Port ticks: a mark where each named socket actually
                                             carries something. Only occupied ports get one — an
                                             empty socket belongs in the rail, not on a diagram
                                             somebody is reading in a hurry. A shared socket draws
                                             wider, because two cables in one jack is a fact. -->
                                        <Canvas IsHitTestVisible="False">
                                            <ItemsControl ItemsSource="{Binding LeftPortAnchors}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.Styles>
                                                    <Style Selector="ContentPresenter" x:DataType="vm:MapPortAnchor">
                                                        <Setter Property="Canvas.Left" Value="-2" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    </Style>
                                                </ItemsControl.Styles>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:MapPortAnchor">
                                                        <Border Height="10" CornerRadius="3"
                                                                Width="{Binding IsShared, Converter={x:Static views:MapConverters.PortTickWidth}}"
                                                                Background="{StaticResource TextFaintBrush}"
                                                                ToolTip.Tip="{Binding Label}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding RightPortAnchors}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.Styles>
                                                    <Style Selector="ContentPresenter" x:DataType="vm:MapPortAnchor">
                                                        <Setter Property="Canvas.Left" Value="204" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    </Style>
                                                </ItemsControl.Styles>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:MapPortAnchor">
                                                        <Border Height="10" CornerRadius="3"
                                                                Width="{Binding IsShared, Converter={x:Static views:MapConverters.PortTickWidth}}"
                                                                Background="{StaticResource TextFaintBrush}"
                                                                ToolTip.Tip="{Binding Label}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>

                                        <!-- Wire handles. Visible only while editing, because
                                             they are an affordance, not decoration. -->
                                        <Border Width="26" HorizontalAlignment="Left" Margin="1,7"
                                                CornerRadius="7,0,0,7"
                                                Background="{StaticResource Overlay06Brush}"
                                                IsVisible="{Binding $parent[Window].((vm:MapWorkspaceViewModel)DataContext).IsEditing}"
                                                IsHitTestVisible="False" />
                                        <Border Width="26" HorizontalAlignment="Right" Margin="1,7"
                                                CornerRadius="0,7,7,0"
                                                Background="{StaticResource Overlay06Brush}"
                                                IsVisible="{Binding $parent[Window].((vm:MapWorkspaceViewModel)DataContext).IsEditing}"
                                                IsHitTestVisible="False" />

                                        <!-- The 3px accent bar: the dominant signal type. -->
                                        <Border Width="3" HorizontalAlignment="Left" Margin="0,10"
                                                CornerRadius="1.5" Background="{Binding AccentBrush}"
                                                IsVisible="{Binding HasAccent}" />

                                        <Grid RowDefinitions="Auto,Auto" Margin="14,11,12,0"
                                              VerticalAlignment="Top">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto">
                                                <TextBlock Grid.Column="0" Classes="nodeTitle"
                                                           Text="{Binding Label}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            Spacing="6" VerticalAlignment="Center">
                                                    <!-- Tier badge, when the tier needs saying. -->
                                                    <Border CornerRadius="3" Padding="6,2"
                                                            IsVisible="{Binding IsReported}"
                                                            Background="#1F4a93e0" BorderThickness="1"
                                                            BorderBrush="#804a93e0">
                                                        <TextBlock Classes="tierBadge" Text="REPORTED"
                                                                   Foreground="{StaticResource ActionBrush}" />
                                                    </Border>
                                                    <Border CornerRadius="3" Padding="6,2"
                                                            IsVisible="{Binding IsHuman}"
                                                            Background="#1Fd6a53c" BorderThickness="1"
                                                            BorderBrush="{StaticResource WaitBorderBrush}">
                                                        <TextBlock Classes="tierBadge" Text="ASK A HUMAN"
                                                                   Foreground="{StaticResource WaitBrush}" />
                                                    </Border>

                                                    <!-- The failing state badge: NO PING / DOWN. -->
                                                    <Border CornerRadius="20" Padding="7,2"
                                                            Background="{StaticResource FailBrush}"
                                                            IsVisible="{Binding ShowsFailure}">
                                                        <TextBlock Classes="tierBadge"
                                                                   Text="{Binding FailBadge}"
                                                                   Foreground="#0b0d10" />
                                                    </Border>

                                                    <!-- Dots: filled = checked; hollow = inferred,
                                                         never green, never filled. -->
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{StaticResource OkBrush}"
                                                             IsVisible="{Binding ShowsOk}" />
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{StaticResource WaitBrush}"
                                                             IsVisible="{Binding ShowsPolling}" />
                                                    <Ellipse Width="8" Height="8"
                                                             Stroke="{StaticResource TextFainterBrush}"
                                                             StrokeThickness="1.5"
                                                             IsVisible="{Binding ShowsHollowDot}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Classes="nodeSub"
                                                       Text="{Binding Detail}" Margin="0,5,0,0"
                                                       IsVisible="{Binding HasDetail}" />
                                        </Grid>

                                        <!-- Sub-map affordance: a corner chevron on linked boxes. -->
                                        <TextBlock Text="›" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource TextFainterBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   Margin="0,0,9,2" IsVisible="{Binding HasLink}" />
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </ScrollViewer>

                <!-- Building: the same devices, grouped by where you would walk to. -->
                <ScrollViewer IsVisible="{Binding IsBuilding}" AllowAutoHide="False" Padding="26,20">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="mono" FontSize="11" LetterSpacing="1.4"
                                   Foreground="{StaticResource TextFainterBrush}"
                                   Text="EVERY BOX ON THIS MAP, BY THE ROOM IT LIVES IN &#183; ROOMS WITH A FAULT COME FIRST" />
                        <ItemsControl ItemsSource="{Binding Rooms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MapRoomViewModel">
                                    <Border Width="330" Margin="0,0,16,16" CornerRadius="12"
                                            Padding="16,14" VerticalAlignment="Top"
                                            Background="{StaticResource PanelRaisedBrush}"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource HairlineBrush}"
                                            Classes.roomFail="{Binding HasFailure}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" FontSize="16"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Classes="mono" FontSize="10"
                                                           VerticalAlignment="Center" LetterSpacing="0.8"
                                                           Foreground="{StaticResource TextFainterBrush}"
                                                           Text="{Binding CountLabel}" />
                                            </Grid>
                                            <TextBlock Classes="mono" FontSize="11" LetterSpacing="0.8"
                                                       Foreground="{StaticResource FailTagBrush}"
                                                       Text="{Binding StateLabel}"
                                                       IsVisible="{Binding StateLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <ItemsControl ItemsSource="{Binding Devices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:MapDeviceViewModel">
                                                        <Grid ColumnDefinitions="Auto,10,*" Margin="0,0,0,6">
                                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                     Fill="{StaticResource FailBrush}"
                                                                     IsVisible="{Binding ShowsFailure}" />
                                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                     Fill="{StaticResource OkBrush}"
                                                                     IsVisible="{Binding ShowsOk}" />
                                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                     Stroke="{StaticResource TextLockedBrush}"
                                                                     StrokeThickness="1.2" Fill="Transparent"
                                                                     IsVisible="{Binding ShowsHollowDot}" />
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="{Binding Label}" FontSize="13.5" />
                                                                <TextBlock Classes="mono" FontSize="10.5"
                                                                           Foreground="{StaticResource TextFainterBrush}"
                                                                           Text="{Binding Detail}"
                                                                           IsVisible="{Binding HasDetail}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Stream path: the chain out of the building, and where it stops. -->
                <ScrollViewer IsVisible="{Binding IsStreamPath}" AllowAutoHide="False" Padding="26,20">
                    <StackPanel Spacing="18">
                        <TextBlock FontSize="15" TextWrapping="Wrap" MaxWidth="820"
                                   HorizontalAlignment="Left"
                                   Text="{Binding StreamVerdict}" />
                        <ItemsControl ItemsSource="{Binding StreamHops}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MapStreamHopViewModel">
                                    <StackPanel>
                                        <!-- The run into this hop, named, above the box it feeds. -->
                                        <Grid ColumnDefinitions="26,Auto" Margin="0,0,0,2"
                                              IsVisible="{Binding HasArriving}">
                                            <Rectangle Width="2" Height="26" HorizontalAlignment="Center"
                                                       Fill="{StaticResource HairlineBrush}" />
                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="10.5"
                                                       VerticalAlignment="Center" LetterSpacing="0.8"
                                                       Foreground="{StaticResource TextFainterBrush}"
                                                       Text="{Binding ArrivingLabel}" />
                                        </Grid>
                                        <Border CornerRadius="10" Padding="15,12" Width="440"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource PanelRaisedBrush}"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource HairlineBrush}"
                                                Classes.hopBreak="{Binding IsFirstBreak}"
                                                Classes.hopStarved="{Binding IsStarved}">
                                            <Grid ColumnDefinitions="Auto,12,*,12,Auto">
                                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                         Fill="{StaticResource FailBrush}"
                                                         IsVisible="{Binding IsFirstBreak}" />
                                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                         Fill="{StaticResource OkBrush}"
                                                         IsVisible="{Binding IsOk}" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Device.Label}" FontSize="15"
                                                               FontWeight="Medium" />
                                                    <TextBlock Classes="mono" FontSize="10.5"
                                                               Foreground="{StaticResource TextFainterBrush}"
                                                               Text="{Binding Device.Location}"
                                                               IsVisible="{Binding Device.HasLocation}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="4" Classes="mono" FontSize="10"
                                                           VerticalAlignment="Center" LetterSpacing="0.8"
                                                           Foreground="{StaticResource TextFainterBrush}"
                                                           Text="OFF CAMPUS"
                                                           IsVisible="{Binding IsOffCampus}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footnote, pinned to the viewport not the canvas. -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="26,0,0,14"
                        Background="#B00c0f13" CornerRadius="6" Padding="10,5"
                        IsVisible="{Binding IsSignalFlow}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Classes="mono" FontSize="11"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   Text="DOUBLE-CLICK A BOX TO INSPECT IT · CLICK A WIRE TO SELECT IT · IN EDIT MODE: DRAG THE MIDDLE TO MOVE, DRAG FROM EITHER END TO WIRE · DELETE REMOVES · CTRL+Z UNDOES" />
                        <TextBlock Classes="mono" FontSize="11"
                                   Foreground="{StaticResource ActionBrush}"
                                   Text="{Binding ModeLabel}"
                                   IsVisible="{Binding IsEditing}" />
                    </StackPanel>
                </Border>

                <Button Classes="secondary" Content="◂ Back" VerticalAlignment="Top"
                        HorizontalAlignment="Left" Margin="26,14,0,0"
                        IsVisible="{Binding CanGoBack}" Command="{Binding BackCommand}" />

                <!-- Nothing drawn yet: say so and offer the two ways in. -->
                <Border VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                        Background="{StaticResource PanelRaisedBrush}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="30,26" IsVisible="{Binding IsEmpty}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="No map of this building yet" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock FontSize="14" LineHeight="21" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="A map is your gear and the wires between them, drawn live. Boxes can be checked the same way checklist items are — and so can the wires, which is the part a checklist cannot do: it tells you where a path broke, not just that something did." />
                        <StackPanel Spacing="7">
                            <TextBlock Classes="fieldLabel" Text="NAME THE FIRST MAP" />
                            <TextBox Classes="field" FontSize="15" Watermark="System map"
                                     Text="{Binding NewMapName, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="primary" Content="Create an empty map" Padding="18,10"
                                    Command="{Binding CreateFirstMapCommand}" />
                            <Button Classes="secondary" Content="Start from a small example" Padding="18,10"
                                    Command="{Binding CreateExampleMapCommand}" />
                        </StackPanel>
                        <TextBlock Classes="mono" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   Text="{Binding MapsFolder, StringFormat='MAPS ARE SHARED · EVERY STATION READS {0}'}" />
                    </StackPanel>
                </Border>
            </Panel>

            <!-- Right rail -->
            <Border Grid.Column="1" Background="{StaticResource RailBgBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0">
                        <StackPanel Margin="20,18,20,18" Spacing="18">

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="microLabel" Text="SIGNAL TYPES" />
                                <TextBlock Grid.Column="1" Classes="mono" Text="TAP TO ISOLATE"
                                           FontSize="9.5" LetterSpacing="1"
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Legend}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:MapLegendRowViewModel">
                                        <Button Classes="legendRow" Classes.active="{Binding IsIsolated}"
                                                Click="OnLegendRowClick">
                                            <Grid ColumnDefinitions="40,12,*,Auto">
                                                <!-- A live key, not a static swatch. -->
                                                <views:WireSample Grid.Column="0" Width="40" Height="12"
                                                                  Type="{Binding Type}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                           FontSize="13" FontWeight="Medium"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Classes="mono"
                                                           Text="{Binding Count}" FontSize="11"
                                                           Foreground="{StaticResource TextFaintBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Classes="quiet dashed" Content="+ New connection type"
                                    HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                    Click="OnTypesClick" FontSize="13" />

                            <Grid ColumnDefinitions="40,12,*" Margin="8,4,8,0"
                                  IsVisible="{Binding Current.HasLinksDown, FallbackValue=False}">
                                <views:WireSample Grid.Column="0" Width="40" Height="12"
                                                  IsFailSample="True" />
                                <TextBlock Grid.Column="2" Text="Link down" FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource FailTagBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Selected wire (read-only, while not editing) -->
                            <StackPanel Spacing="10">
                                <StackPanel.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasSelectedConnection" />
                                        <Binding Path="ConnectionEditor"
                                                 Converter="{x:Static ObjectConverters.IsNull}" />
                                    </MultiBinding>
                                </StackPanel.IsVisible>
                                <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                <TextBlock Classes="microLabel" Text="SELECTED LINK" />
                                <TextBlock Text="{Binding SelectedConnection.Title, FallbackValue=''}"
                                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border Classes="card" Padding="12,10">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="64,*">
                                            <TextBlock Classes="mono" Text="TYPE" FontSize="10.5"
                                                       Foreground="{StaticResource TextFainterBrush}" />
                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="12"
                                                       Text="{Binding SelectedConnection.Type.Name, FallbackValue=''}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="64,*"
                                              IsVisible="{Binding SelectedConnection.Label, FallbackValue=False, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Classes="mono" Text="PATH" FontSize="10.5"
                                                       Foreground="{StaticResource TextFainterBrush}" />
                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="12"
                                                       Text="{Binding SelectedConnection.Label, FallbackValue=''}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid ColumnDefinitions="64,*"
                                              IsVisible="{Binding SelectedConnection.HasPortRoute, FallbackValue=False}">
                                            <TextBlock Classes="mono" Text="PORTS" FontSize="10.5"
                                                       Foreground="{StaticResource TextFainterBrush}" />
                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="12"
                                                       Text="{Binding SelectedConnection.PortRoute, FallbackValue=''}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid ColumnDefinitions="64,*"
                                              IsVisible="{Binding SelectedConnection.IsBidirectional, FallbackValue=False}">
                                            <TextBlock Classes="mono" Text="FLOW" FontSize="10.5"
                                                       Foreground="{StaticResource TextFainterBrush}" />
                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="12"
                                                       Text="BOTH WAYS ON ONE CABLE" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid ColumnDefinitions="64,*">
                                            <TextBlock Classes="mono" Text="STATE" FontSize="10.5"
                                                       Foreground="{StaticResource TextFainterBrush}" />
                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="12"
                                                       Text="{Binding SelectedConnection.StatusLabel, FallbackValue=''}"
                                                       TextWrapping="Wrap"
                                                       Classes.failText="{Binding SelectedConnection.IsDown, FallbackValue=False}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Button Classes="primary" Content="Ping again" Padding="15,8"
                                            IsVisible="{Binding SelectedConnection.HasVerify, FallbackValue=False}"
                                            Command="{Binding PingAgainCommand}" />
                                    <Button Classes="danger" Content="Delete" Padding="15,8"
                                            IsVisible="{Binding IsEditing}"
                                            Command="{Binding DeleteSelectedCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Selected note -->
                            <StackPanel Spacing="10"
                                        IsVisible="{Binding SelectedNote, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                <TextBlock Classes="microLabel" Text="SELECTED NOTE" />
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           Text="{Binding NoteAttachmentLabel}" />
                                <StackPanel Orientation="Horizontal" Spacing="9"
                                            IsVisible="{Binding IsEditing}">
                                    <Button Classes="quiet" Content="Mark as warning" Padding="13,8"
                                            Command="{Binding ToggleNoteToneCommand}"
                                            IsVisible="{Binding !SelectedNote.IsWarning}" />
                                    <Button Classes="quiet" Content="Make it a plain note" Padding="13,8"
                                            Command="{Binding ToggleNoteToneCommand}"
                                            IsVisible="{Binding SelectedNote.IsWarning}" />
                                    <Button Classes="quiet" Content="Detach" Padding="13,8"
                                            Command="{Binding DetachNoteCommand}"
                                            IsVisible="{Binding SelectedNote.HasTether}"
                                            ToolTip.Tip="Stop this note following its box. It stays where it is." />
                                    <Button Classes="danger" Content="Delete" Padding="15,8"
                                            Command="{Binding DeleteSelectedCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Selected device (read-only, while not editing) -->
                            <StackPanel Spacing="10">
                                <StackPanel.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="SelectedDevice"
                                                 Converter="{x:Static ObjectConverters.IsNotNull}" />
                                        <Binding Path="DeviceEditor"
                                                 Converter="{x:Static ObjectConverters.IsNull}" />
                                    </MultiBinding>
                                </StackPanel.IsVisible>
                                <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                <TextBlock Classes="microLabel" Text="SELECTED DEVICE" />
                                <TextBlock Text="{Binding SelectedDevice.Label, FallbackValue=''}"
                                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Classes="mono" FontSize="12"
                                           Text="{Binding SelectedDevice.Detail, FallbackValue=''}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           IsVisible="{Binding SelectedDevice.HasDetail, FallbackValue=False}" />
                                <TextBlock FontSize="13" TextWrapping="Wrap"
                                           Text="{Binding SelectedDevice.Location, FallbackValue=''}"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           IsVisible="{Binding SelectedDevice.HasLocation, FallbackValue=False}" />
                                <TextBlock Classes="mono" FontSize="12" TextWrapping="Wrap"
                                           Text="{Binding SelectedDevice.StatusLabel, FallbackValue=''}"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <StackPanel Spacing="6"
                                            IsVisible="{Binding SelectedDevice.HasPorts, FallbackValue=False}">
                                    <TextBlock Classes="microLabel" Text="PORTS" />
                                    <ItemsControl ItemsSource="{Binding SelectedDevice.Ports, FallbackValue={x:Null}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:MapPort">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,3">
                                                    <StackPanel>
                                                        <TextBlock Classes="mono" FontSize="12"
                                                                   Text="{Binding Label}" />
                                                        <TextBlock Classes="mono" FontSize="10.5"
                                                                   Foreground="{StaticResource TextFainterBrush}"
                                                                   Text="{Binding Detail}"
                                                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="10"
                                                               VerticalAlignment="Center"
                                                               LetterSpacing="0.8"
                                                               Foreground="{StaticResource TextFainterBrush}"
                                                               Text="{Binding Side}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding SelectedDevice.CheckSteps, FallbackValue={x:Null}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock FontSize="13" TextWrapping="Wrap"
                                                       Text="{Binding}"
                                                       Foreground="{StaticResource TextDimBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Button Classes="primary" Content="Inspect" Padding="15,8"
                                            Click="OnInspectClick" />
                                    <Button Classes="secondary" Content="Open its map" Padding="15,8"
                                            IsVisible="{Binding SelectedDevice.HasLink, FallbackValue=False}"
                                            Click="OnOpenLinkedClick" />
                                    <Button Classes="primary" Content="Check now" Padding="15,8"
                                            IsVisible="{Binding SelectedDevice.HasVerify, FallbackValue=False}"
                                            Command="{Binding PingAgainCommand}" />
                                    <Button Classes="danger" Content="Delete" Padding="15,8"
                                            IsVisible="{Binding IsEditing}"
                                            Command="{Binding DeleteSelectedCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- The conclusion, in plain English. The handoff's rule: a trace
                                 that makes the volunteer infer the cause has failed at its job. -->
                            <Border Classes="card" Padding="14,12" IsVisible="{Binding HasSelectedVerdict}"
                                    BorderBrush="{StaticResource WaitBorderBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="microLabel" Text="WHAT THIS MEANS" />
                                    <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                               Text="{Binding SelectedVerdict}"
                                               Foreground="{StaticResource TextDimBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Device editor: how a box gets its name, tier and check. -->
                            <StackPanel Spacing="11"
                                        IsVisible="{Binding DeviceEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                <TextBlock Classes="microLabel" Text="EDIT DEVICE" />
                                <StackPanel Spacing="11" DataContext="{Binding DeviceEditor}">
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="LABEL" />
                                        <TextBox Classes="field" FontSize="14"
                                                 Text="{Binding Label, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="SUB-LINE (TRANSPORT · ADDRESS)" />
                                        <TextBox Classes="field" FontSize="13"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding Detail, Mode=TwoWay}"
                                                 Watermark="NDI · 10.0.1.21" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,10,*">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Classes="fieldLabel" Text="KIND" />
                                            <ComboBox ItemsSource="{Binding Kinds}"
                                                      SelectedItem="{Binding Kind, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Classes="fieldLabel" Text="ACCENT TYPE" />
                                            <ComboBox ItemsSource="{Binding DominantTypes}"
                                                      SelectedItem="{Binding DominantType, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="HOW THE APP KNOWS ITS STATE" />
                                        <ComboBox ItemsSource="{Binding Tiers}"
                                                  SelectedItem="{Binding Tier, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Foreground="{StaticResource TextFaintBrush}"
                                                   Text="verified needs a check below and can hold Ready to go · reported believes a third-party API · inferred is drawn hollow · human becomes somebody's job" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox Content="Hub" FontSize="13"
                                                  IsChecked="{Binding Hub, Mode=TwoWay}"
                                                  ToolTip.Tip="The PCs and consoles everything converges on. Brighter surface, same size." />
                                        <CheckBox Content="Off campus" FontSize="13"
                                                  IsChecked="{Binding OffCampus, Mode=TwoWay}"
                                                  ToolTip.Tip="Beyond the property line. Can never block Ready to go, whatever its tier." />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="OPENS SUB-MAP" />
                                        <ComboBox ItemsSource="{Binding LinkTargets}"
                                                  SelectedItem="{Binding LinksTo, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="WHERE IT PHYSICALLY IS" />
                                        <TextBox Classes="field" FontSize="13"
                                                 Text="{Binding Location, Mode=TwoWay}"
                                                 Watermark="Grey box on the shelf behind the booth" />
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                    <TextBlock Classes="fieldLabel" Text="VERIFIER — SAME KINDS AS THE CHECKLIST" />
                                    <ComboBox ItemsSource="{Binding VerifyKinds}"
                                              SelectedItem="{Binding VerifyKind, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               Text="{Binding GuideText}"
                                               IsVisible="{Binding HasGuide}" />
                                    <StackPanel IsVisible="{Binding ShowUrl}">
                                        <TextBlock Classes="fieldLabel" Text="URL" />
                                        <TextBox Classes="field" FontSize="13"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding Url, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowContains}">
                                        <TextBlock Classes="fieldLabel" Text="BODY MUST CONTAIN" />
                                        <TextBox Classes="field" FontSize="13"
                                                 Text="{Binding Contains, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowHost}">
                                        <TextBlock Classes="fieldLabel" Text="HOST" />
                                        <TextBox Classes="field" FontSize="13"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding Host, Mode=TwoWay}"
                                                 Watermark="cam3.local or 10.0.1.23" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowPort}">
                                        <TextBlock Classes="fieldLabel" Text="TCP PORT (BLANK = PING)" />
                                        <TextBox Classes="field" FontSize="13"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding Port, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowProcessName}">
                                        <TextBlock Classes="fieldLabel" Text="PROCESS NAME" />
                                        <TextBox Classes="field" FontSize="13"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding ProcessName, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowNameContains}">
                                        <TextBlock Classes="fieldLabel" Text="NAME CONTAINS" />
                                        <TextBox Classes="field" FontSize="13"
                                                 Text="{Binding NameContains, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowPath}">
                                        <TextBlock Classes="fieldLabel" Text="PATH" />
                                        <TextBox Classes="field" FontSize="13"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding Path, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="WHAT TO CHECK WHEN IT FAILS (ONE PER LINE)" />
                                        <TextBox Classes="field" FontSize="13" AcceptsReturn="True"
                                                 MinHeight="64" TextWrapping="Wrap"
                                                 Text="{Binding CheckSteps, Mode=TwoWay}"
                                                 Watermark="Is the PoE injector lit? Say where yours is." />
                                    </StackPanel>
                                </StackPanel>
                                <Button Classes="primary" Content="Apply changes" Padding="16,9"
                                        Command="{Binding ApplyEditorCommand}" />
                            </StackPanel>

                            <!-- Connection editor -->
                            <StackPanel Spacing="11"
                                        IsVisible="{Binding ConnectionEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                <TextBlock Classes="microLabel" Text="EDIT CONNECTION" />
                                <StackPanel Spacing="11" DataContext="{Binding ConnectionEditor}">
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="SIGNAL TYPE" />
                                        <ComboBox ItemsSource="{Binding TypeIds}"
                                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="LABEL (PORTS, UNIVERSE, …)" />
                                        <TextBox Classes="field" FontSize="13"
                                                 Text="{Binding Label, Mode=TwoWay}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,10,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Classes="fieldLabel" Text="CABLE LENGTH FT" />
                                            <TextBox Classes="field" FontSize="13"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     Text="{Binding LengthFt, Mode=TwoWay}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Content="Standby" FontSize="13"
                                                  VerticalAlignment="Bottom" Margin="0,0,0,6"
                                                  IsChecked="{Binding Standby, Mode=TwoWay}"
                                                  ToolTip.Tip="A path that exists but is not carrying anything by design. Drawn grey and still." />
                                    </Grid>

                                    <CheckBox Content="Carries both ways on one cable" FontSize="13"
                                              IsChecked="{Binding Bidirectional, Mode=TwoWay}"
                                              ToolTip.Tip="An AES50 snake, a network trunk, a USB link. Drawn as one wire with flow in both directions, and treated as broken from either end." />

                                    <StackPanel Spacing="11" IsVisible="{Binding HasPortChoices}">
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="LEAVES FROM PORT" />
                                            <ComboBox ItemsSource="{Binding FromPorts}"
                                                      SelectedItem="{Binding FromPort, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="ARRIVES AT PORT" />
                                            <ComboBox ItemsSource="{Binding ToPorts}"
                                                      SelectedItem="{Binding ToPort, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                    <TextBlock Classes="fieldLabel" Text="DOES THE SIGNAL ACTUALLY ARRIVE?" />
                                    <ComboBox ItemsSource="{Binding VerifyKinds}"
                                              SelectedItem="{Binding VerifyKind, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               Text="{Binding GuideText}"
                                               IsVisible="{Binding HasGuide}" />
                                    <StackPanel IsVisible="{Binding ShowUrl}">
                                        <TextBlock Classes="fieldLabel" Text="URL" />
                                        <TextBox Classes="field" FontSize="13"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding Url, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowContains}">
                                        <TextBlock Classes="fieldLabel" Text="BODY MUST CONTAIN" />
                                        <TextBox Classes="field" FontSize="13"
                                                 Text="{Binding Contains, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowHost}">
                                        <TextBlock Classes="fieldLabel" Text="HOST" />
                                        <TextBox Classes="field" FontSize="13"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding Host, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowPort}">
                                        <TextBlock Classes="fieldLabel" Text="TCP PORT (BLANK = PING)" />
                                        <TextBox Classes="field" FontSize="13"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding Port, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowProcessName}">
                                        <TextBlock Classes="fieldLabel" Text="PROCESS NAME" />
                                        <TextBox Classes="field" FontSize="13"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding ProcessName, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowNameContains}">
                                        <TextBlock Classes="fieldLabel" Text="NAME CONTAINS" />
                                        <TextBox Classes="field" FontSize="13"
                                                 Text="{Binding NameContains, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding ShowPath}">
                                        <TextBlock Classes="fieldLabel" Text="PATH" />
                                        <TextBox Classes="field" FontSize="13"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Text="{Binding Path, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Classes="primary" Content="Apply changes" Padding="16,9"
                                        Command="{Binding ApplyEditorCommand}" />
                            </StackPanel>

                            <TextBlock Classes="mono" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       Text="{Binding Status}"
                                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SHOW chips + housekeeping -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="0,1,0,0" Padding="20,13">
                        <StackPanel Spacing="11">
                            <TextBlock Classes="microLabel" Text="SHOW" />
                            <WrapPanel>
                                <Button Classes="chip" Content="All signals" Margin="0,0,7,7"
                                        Command="{Binding SetCategoryCommand}" CommandParameter="{x:Null}" />
                                <Button Classes="chip" Content="Video only" Margin="0,0,7,7"
                                        Command="{Binding SetCategoryCommand}" CommandParameter="video" />
                                <Button Classes="chip" Content="Audio only" Margin="0,0,7,7"
                                        Command="{Binding SetCategoryCommand}" CommandParameter="audio" />
                                <Button Classes="chip" Content="Lighting" Margin="0,0,7,7"
                                        Command="{Binding SetCategoryCommand}" CommandParameter="lighting" />
                                <Button Classes="chip" Content="Faults only" Margin="0,0,7,7"
                                        Command="{Binding SetCategoryCommand}" CommandParameter="faults" />
                            </WrapPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <CheckBox Content="Freeze wires" FontSize="13"
                                          IsChecked="{Binding FreezeWires, Mode=TwoWay}"
                                          ToolTip.Tip="The map stays fully readable with all animation off — for a slow booth PC or a wall display." />
                                <Button Grid.Column="2" Classes="primary" Content="Save map"
                                        Padding="16,8" IsVisible="{Binding IsEditing}"
                                        Command="{Binding SaveCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
