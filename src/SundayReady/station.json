{
  // Local to this PC. Delete this file to fall back to hostname auto-detect.
  "station": "Livestream Video",
  "operator": "J. Mercer",
  "checklists": [
    "livestream-video.json",
    "livestream-audio.json",
    "go-live.json",
    "shutdown.json"
  ],
  "service": {
    "doorsAt": "10:15",
    "streamAt": "10:25",
    // Every service on a service day. The countdown targets the next one, and the checklist
    // starts again 90 minutes (resetLeadMinutes) before each — which is what a PC that is
    // never switched off needs, since it will never see a restart.
    "starts": ["09:00", "11:00"],
    "resetLeadMinutes": 90,
    "venue": "SANCTUARY"
  },
  // Techdesk. Set "techdesk": true on the tech director's PC — same binary, different screen.
  // Every station writes a heartbeat snapshot to "techdeskShare"; leave it empty and it falls
  // back to %LOCALAPPDATA%\SundayReady\techdesk, which only that PC can see.
  // "techdeskShare": "\\\\CHURCH-NAS\\AV\\sundayready",
  "techdeskLayout": "columns",
  "techdeskHeartbeatMinutes": 22,
  // The four tiles in the bottom right of the station screen. Edit them in
  // Settings → Quick launch; these are only a starting point.
  "quickLaunch": [
    { "label": "vMix", "action": { "run": "C:\\Program Files (x86)\\vMix\\vMix64.exe" } },
    { "label": "ProPresenter", "action": { "run": "C:\\Program Files\\Renewed Vision\\ProPresenter\\ProPresenter.exe" } },
    { "label": "Subsplash", "action": { "run": "https://www.subsplash.com/login" } },
    { "label": "Sound settings", "action": { "run": "ms-settings:sound" } }
  ]
}
